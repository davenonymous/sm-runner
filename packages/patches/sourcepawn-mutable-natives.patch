+// smrunner: the runner is told of every change of a native's binding, so
+// that its hooks follow SourceMod's own rebinding (a provider plugin
+// reloaded, an optional native bound late). One listener, null for none.
+typedef void (*SmRunnerNativeBindingListener)(IPluginRuntime* runtime, uint32_t index);
+static SmRunnerNativeBindingListener sNativeBindingListener = nullptr;
+
+EXPORTFUNC void
+SmRunnerSetNativeBindingListener(SmRunnerNativeBindingListener listener)
+{
+  sNativeBindingListener = listener;
+}
